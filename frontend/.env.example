# Copy to .env.local for local overrides, or set in Vercel's dashboard for production.
#
# Leave this UNSET for local development: the Vite dev server proxies /api to
# http://127.0.0.1:8000 automatically (see vite.config.js), so no config needed.
#
# In production, point it at your deployed Render backend (no trailing slash):
# VITE_API_BASE_URL=https://weather-dashboard-api.onrender.com
VITE_API_BASE_URL=
